+
+// Verificación de igualdad simbólica (heredada de v2b)
 restriction Verificacion_Exitosa:
     "All x y #i. Eq(x, y) @i ==> x = y"
 
+// [Cambio 4] Unicidad de instancias de setup — supuestos declarados explícitos.
+// Garantizan que en cualquier traza considerada solo existe una AC, una AR
+// y un SV, reflejando el despliegue real del sistema electoral.
 restriction SetupAC_Unico:
     "All a b #i #j. SetupAC(a) @i & SetupAC(b) @j ==> #i = #j"
 
@@ -39,6 +54,19 @@
 restriction SetupSV_Unico:
     "All a b #i #j. SetupSV(a) @i & SetupSV(b) @j ==> #i = #j"
 
+// [Cambio 1] Unicidad de la clausura: el cierre de urna ocurre a lo sumo una
+// vez. Refleja el control de integridad del proceso electoral donde la ventana
+// de votación tiene inicio y fin deterministas.
+restriction Cierre_Unico:
+    "All #i #j. Cierre() @i & Cierre() @j ==> #i = #j"
+
+// [Cambio 1] Toda aceptación de voto debe ocurrir antes del cierre de urna.
+// Impide que el adversario inyecte boletas después de declarado el cierre,
+// cerrando la brecha de orden temporal en el modelo.
+restriction NoVotoTrasCierre:
+    "All id blt sig #ta #tc.
+        VotoAceptado(id, blt, sig) @ta & Cierre() @tc ==> #ta < #tc"
+
