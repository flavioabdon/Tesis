+// [Cambio 1] Clausura de la urna de votación.
+// Produce el hecho persistente !UrnaCerrada() que habilita el escrutinio.
+// Restriction Cierre_Unico garantiza que esta regla se dispara a lo sumo una vez.
+// Restriction NoVotoTrasCierre garantiza que todos los VotoAceptado precedan
+// a esta acción de cierre.
+rule Cierre_Votacion:
+    [ ]
+  --[ Cierre() ]->
+    [ !UrnaCerrada() ]
+
+// [Cambio 1] Apertura y Escrutinio (AC).
+// Ahora exige !UrnaCerrada() como premisa: el escrutinio solo puede iniciarse
+// una vez que la urna ha sido formalmente cerrada, forzando el orden temporal
+// clausura -> escrutinio en el modelo.
 rule Apertura_Anfora_Y_Escrutinio:
     let k_recuperada = decaps(~dk_AC, ct_kem)
