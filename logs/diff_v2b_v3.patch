+// [Cambio 2] Revelación de clave privada de firma de la AR.
+// Permite modelar el escenario en que la AR es comprometida: el adversario
+// podría forjar credenciales de registro para votantes no empadronados.
+rule Reveal_Clave_AR:
+    [ !ClavePrivadaAR('AR', ~sk_AR) ]
+  --[ Rev('AR', 'AR') ]->
+    [ Out(~sk_AR) ]
+
+// [Cambio 2] Revelación de clave privada de firma del SV.
+// Permite modelar la corrupción del servidor de votación: el adversario podría
+// forjar recibos, pero no descifrar votos (dk_AC permanece en la AC).
+rule Reveal_Clave_SV:
+    [ !ClavePrivadaFirma_SV('SV', ~sk_SV) ]
+  --[ Rev('SV', 'SV') ]->
+    [ Out(~sk_SV) ]
